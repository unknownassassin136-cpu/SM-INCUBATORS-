# ==========================================
# SM INCUBATORS BACKEND ENVIRONMENT CONFIG
# ==========================================

# 1. Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# 2. Supabase Database Connection (For Drizzle ORM)
# Get this from: Supabase Project Settings -> Database -> Connection string (URI) -> Mode: Transaction or Session
# Format: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# 3. Supabase API Credentials (Optional / for Auth & Direct SDK if needed)
# Get this from: Supabase Project Settings -> API
SUPABASE_URL=https://yourprojectref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 4. Admin Authentication Credentials
# Admin login details for the Admin Panel
ADMIN_EMAIL=admin@smincubators.in
ADMIN_PASSWORD=change_this_secure_password
JWT_SECRET=super_secret_jwt_key_smincubators_2026_xyz!

# 5. Firebase Storage Bucket Configuration
# Get this from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=sm-incubators
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@sm-incubators.iam.gserviceaccount.com
# Note: Keep the newline characters \n intact in private key
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# Firebase Storage Bucket URL (without gs:// prefix)
# Found in: Firebase Console -> Storage -> gs://sm-incubators.appspot.com or sm-incubators.firebasestorage.app
FIREBASE_STORAGE_BUCKET=sm-incubators.firebasestorage.app

